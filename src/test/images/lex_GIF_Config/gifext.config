        # writable directory
        'LEXTEST3/003' => {
            Name => 'LexTestXMP',
            Writable => 2,
            IncludeLengthBytes => 2,
            Terminator => q(<\\?xpacket end=['"][wr]['"]\\?>),
            SubDirectory => { TagTable => 'Image::ExifTool::XMP::Main' },
        },
    },
);

# user-defined GIF application extensions (lexiftool test fixture)
%Image::ExifTool::UserDefined = (
    'Image::ExifTool::GIF::Extensions' => {
        # data split into 255-byte sub-blocks
        'LEXTEST1/001' => { Name => 'LexTestText', Writable => 'string' },
        # data includes the length bytes, padded with nulls

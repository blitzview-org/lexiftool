# Description:  Test config file: a hash reference assigned to a package
#               hash (a common slip: the hash then holds no usable entry)
#
# test: -s -TestRefShort vendor/exiftool/t/images/Canon.jpg
# test: -s -Make vendor/exiftool/t/images/Canon.jpg

%Image::ExifTool::UserDefined::Shortcuts = {
    TestRefShort => 'Make',
};

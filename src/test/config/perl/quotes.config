#------------------------------------------------------------------------------
# File:         quotes.config
#
# Description:  Test config file: the Perl string forms, shown as tag
#               descriptions and PrintConv values
#
# test: -n -XMP-testq:all=1 -o OUT.xmp vendor/exiftool/t/images/XMP.xmp
# test: -a -G1 -XMP-testq:all LAST.xmp
# test: -a -G1 -n -XMP-testq:all LAST.xmp
# test: -listx -XMP-testq:all
#------------------------------------------------------------------------------

%Image::ExifTool::UserDefined = (
    'Image::ExifTool::XMP::Main' => {
        testq => { SubDirectory => { TagTable => 'Image::ExifTool::UserDefined::testq' } },
    },
);

%Image::ExifTool::UserDefined::testq = (
    GROUPS    => { 0 => 'XMP', 1 => 'XMP-testq', 2 => 'Other' },
    NAMESPACE => { 'testq' => 'http://example.com/ns/testq/1.0/' },
    WRITABLE  => 'integer',
    Single    => { Description => 'single \'quoted\' with \\ and \n kept', PrintConv => { 1 => 'one\two' } },
    Double    => { Description => "double \"quoted\"\tTab \x41\x{42}\103 \$ \@ end\$", PrintConv => { 1 => "a\\b" } },
    QBrace    => { Description => q{q braces {nested} \{ \} \\}, PrintConv => { 1 => q(paren (x)) } },
    QOther    => { Description => q!bang \! here!, PrintConv => { 1 => q<angle <a>> } },
    QHash     => { Description => q#hash delim#, PrintConv => { 1 => q[square [b]] } },
    QQ        => { Description => qq{qq braces {x} \x26 \}}, PrintConv => { 1 => qq|bar \| pipe| } },
    QSpace    => { Description => q {space before brace}, PrintConv => { 1 => qq
                    /newline before slash/ } },
    Multi     => { Description => 'multi
line', PrintConv => { 1 => "at end \@" } },
    Concat    => { Description => 'con' . "cat" . q{enated}, PrintConv => { 1 => 'x' . 2 } },
    Empty     => { Description => '', PrintConv => { 1 => "" } },
    AtSign    => { Description => "at \@sign and a@ b", PrintConv => { 1 => '@x $y' } },
);

1;  #end

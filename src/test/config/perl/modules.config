#------------------------------------------------------------------------------
# File:         modules.config
#
# Description:  Test config file: use and require of ExifTool modules, an
#               element assignment to a module's tag table, a call of
#               RegisterNamespace and the pragmas
#
# test: -Artist=me -o OUT.mov vendor/exiftool/t/images/QuickTime.mov
# test: -a -G1 -s -Keys:all -ItemList:Artist LAST.mov
# test: -XMP-testm:Value=abc -o OUT.xmp vendor/exiftool/t/images/XMP.xmp
# test: -a -G1 -s -XMP-testm:all LAST.xmp
# test: -listx -XMP-testm:all
#------------------------------------------------------------------------------

use strict;
use warnings;
no warnings 'once';
use Image::ExifTool qw(:Public);

# (use is done at compile time: the module is loaded before this assignment)
$Image::ExifTool::QuickTime::Keys{PREFERRED} = 3;
use Image::ExifTool::QuickTime;

%Image::ExifTool::UserDefined = (
    'Image::ExifTool::XMP::Main' => {
        testm => { SubDirectory => { TagTable => 'Image::ExifTool::UserDefined::testm' } },
    },
);

%Image::ExifTool::UserDefined::testm = (
    GROUPS    => { 0 => 'XMP', 1 => 'XMP-testm', 2 => 'Other' },
    NAMESPACE => { 'testm' => 'http://example.com/ns/testm/1.0/' },
    WRITABLE  => 'string',
    Value     => { },
);

require Image::ExifTool::XMP;
Image::ExifTool::XMP::RegisterNamespace(\%Image::ExifTool::UserDefined::testm);

1;  #end

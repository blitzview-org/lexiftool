#------------------------------------------------------------------------------
# File:         foreign.config
#
# Description:  Test config file: new tag tables in other ExifTool packages
#
# test: -XMP-testf:Value=v -o OUT.xmp vendor/exiftool/t/images/XMP.xmp
# test: -a -G1 -s -XMP-testf:all LAST.xmp
# test: -listx -XMP-testf:all
# test: -a -G1 -s -XMP:all LAST.xmp
#------------------------------------------------------------------------------

%Image::ExifTool::UserDefined = (
    'Image::ExifTool::XMP::Main' => {
        testf => { SubDirectory => { TagTable => 'Image::ExifTool::XMP::testf' } },
        testg => { SubDirectory => { TagTable => 'Image::ExifTool::NoSuchModule::testg' } },
    },
);

%Image::ExifTool::XMP::testf = (
    GROUPS    => { 0 => 'XMP', 1 => 'XMP-testf', 2 => 'Other' },
    NAMESPACE => { 'testf' => 'http://example.com/ns/testf/1.0/' },
    WRITABLE  => 'string',
    Value     => { },
);

%Image::ExifTool::NoSuchModule::testg = (
    GROUPS    => { 0 => 'XMP', 1 => 'XMP-testg', 2 => 'Other' },
    NAMESPACE => { 'testg' => 'http://example.com/ns/testg/1.0/' },
    Other     => { },
);

1;  #end

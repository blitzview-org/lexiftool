#------------------------------------------------------------------------------
# File:         mixin.config
#
# Description:  Test config file: a package hash spliced into a table, a
#               new MIE group, a hash dereference and a reference to a table
#               defined further down
#
# test: -TestMie1=1.5 -TestMie2=text -o OUT.mie vendor/exiftool/t/images/MIE.mie
# test: -a -G1 -s -MIE-Testmix:all LAST.mie
# test: '-XMP-testr:Item={Width=5,Note=n}' -XMP-testr:Extra=e -o OUT.xmp vendor/exiftool/t/images/XMP.xmp
# test: -a -G1 -s -struct -XMP-testr:all LAST.xmp
# test: -listx -MIE-Testmix:all -XMP-testr:all
#------------------------------------------------------------------------------

use Image::ExifTool::MIE;

%Image::ExifTool::UserDefined = (
    'Image::ExifTool::MIE::Meta' => {
        Testmix => {
            SubDirectory => {
                TagTable => 'Image::ExifTool::UserDefined::Testmix',
                DirName => 'Testmix',
            },
        },
    },
    'Image::ExifTool::XMP::Main' => {
        testr => { SubDirectory => { TagTable => 'Image::ExifTool::UserDefined::testr' } },
    },
);

%Image::ExifTool::UserDefined::Testmix = (
    %Image::ExifTool::MIE::tableDefaults,
    GROUPS => { 0 => 'MIE', 1 => 'MIE-Testmix', 2 => 'Image' },
    WRITE_GROUP => 'MIE-Testmix',
    TestMie1 => { Writable => 'rational64u' },
    TestMie2 => { },
);

%Image::ExifTool::UserDefined::testr = (
    %{ { GROUPS => { 0 => 'XMP', 1 => 'XMP-testr', 2 => 'Other' } } },
    NAMESPACE => { 'testr' => 'http://example.com/ns/testr/1.0/' },
    WRITABLE  => 'string',
    # (the structure is defined below; the reference is to the same hash)
    Item      => { Struct => \%Image::ExifTool::UserDefined::testrStruct },
    Extra     => { },
);

%Image::ExifTool::UserDefined::testrStruct = (
    Width => { Writable => 'integer' },
    Note  => { },
);

1;  #end

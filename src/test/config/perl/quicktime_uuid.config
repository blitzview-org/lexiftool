#------------------------------------------------------------------------------
# File:         quicktime_uuid.config
#
# Description:  Test config file: XMP in a QuickTime 'uuid' atom with an own
#               UUID, which the Condition string recognises -- a new atom
#               takes its UUID from that string (data only; the same tag in
#               the Lua format is src/test/config/quicktime_uuid.lua)
#
# test: -XMP:Title=LexiTest -o OUT.m4a vendor/exiftool/t/images/QuickTime.m4a
# test: -a -G1 -s -XMP:all LAST.m4a
# test: -XMP:Title=Again -XMP:Subject=x -o OUT.m4a LAST.m4a
# test: -a -G1 -s -XMP:all LAST.m4a
#------------------------------------------------------------------------------

%Image::ExifTool::UserDefined = (
    'Image::ExifTool::QuickTime::Main' => {
        uuid => {
            Name => 'LexTestUUID',
            Condition => '$$valPt=~/^LEXTEST\x2duuid\x00\x01\x02\xfe/',
            WriteGroup => 'XMP',
            SubDirectory => {
                TagTable => 'Image::ExifTool::XMP::Main',
                DirName => 'XMP',
                Start => 16,
            },
        },
    },
);

1;  #end

# Description:  Test config file: a call of a subroutine whose module is not
#               loaded dies at run time; the statements before it stay
#
# test: -s -TestBefore -TestAfter vendor/exiftool/t/images/Canon.jpg

%Image::ExifTool::UserDefined::Shortcuts = ( TestBefore => 'Make' );
Image::ExifTool::XMP::RegisterNamespace(
    \%Image::ExifTool::UserDefined::Shortcuts
);
$Image::ExifTool::UserDefined::Shortcuts{TestAfter} = 'Model';
1;

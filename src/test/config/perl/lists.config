#------------------------------------------------------------------------------
# File:         lists.config
#
# Description:  Test config file: qw() lists, barewords, Shortcuts, Options,
#               Lenses, FileTypes and Arguments
#
# test: -s -TestShort -TestQw -TestAlias vendor/exiftool/t/images/Canon.jpg
# test: -s -LensID vendor/exiftool/t/images/Canon.jpg vendor/exiftool/t/images/Pentax.jpg
# test: -G1 -s -Make -Model vendor/exiftool/t/images/Canon.jpg
# test: -s -FileType -MIMEType vendor/exiftool/t/images/Canon.jpg
# test: -listx -XMP-testl:all
# test: -XMP-testl:Kind=Alpha -o OUT.xmp vendor/exiftool/t/images/XMP.xmp
# test: -G1 -XMP-testl:all LAST.xmp
#------------------------------------------------------------------------------

%Image::ExifTool::UserDefined::Shortcuts = (
    TestShort => [ 'Make', 'Model', ],
    TestQw    => [ qw(ExposureTime FNumber
                      ISO) ],
    TestAlias => 'FocalLength',
);

%Image::ExifTool::UserDefined::Options = (
    Duplicates => 1,
    PrintConv  => 1,
    -1         => 'ignored',
);

@Image::ExifTool::UserDefined::Lenses = qw(
    unused1
    unused2
);

%Image::ExifTool::UserDefined = (
    'Image::ExifTool::XMP::Main' => {
        testl => { SubDirectory => { TagTable => Image::ExifTool::UserDefined::testl } },
    },
);

%Image::ExifTool::UserDefined::testl = (
    GROUPS    => { 0 => XMP, 1 => 'XMP-testl', 2 => Other },
    NAMESPACE => { testl => 'http://example.com/ns/testl/1.0/' },
    Kind      => {
        Writable => string,
        PrintConv => { Alpha => First, Beta => Second, -dash => Third },
        PrintConvInv => '$val',
    },
);

1;

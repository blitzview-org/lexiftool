# Description:  Test config file: package variables that a module reads when
#               it is loaded -- the old shortcut hash and the Geolocation
#               database directory
#
# test: -s -TestOld -TestNew vendor/exiftool/t/images/Canon.jpg
# test: -api Geolocation=Paris -G1 -s -Geolocation* vendor/exiftool/t/images/GIF.gif

%Image::ExifTool::Shortcuts::UserDefined = (
    TestOld => [ 'Make' ],
    TestNew => [ 'ISO' ],
);
%Image::ExifTool::UserDefined::Shortcuts = (
    TestNew => [ 'Model' ],
);
# (an empty directory name disables the Geolocation database)
$Image::ExifTool::Geolocation::geoDir = '';
1;

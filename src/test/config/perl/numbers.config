#------------------------------------------------------------------------------
# File:         numbers.config
#
# Description:  Test config file: number forms as tag IDs, hash keys and
#               values, and constant expressions
#
# test: -TestHex=1 -TestDec=2 -TestOct=8 -TestBin=10 -TestNeg=-1 -TestExpr=16 -o OUT.jpg vendor/exiftool/t/images/Writer.jpg
# test: -a -G1 -s -EXIF:all LAST.jpg
# test: -a -G1 -s -n -EXIF:all LAST.jpg
# test: -listx -EXIF:TestHex -EXIF:TestDec -EXIF:TestOct -EXIF:TestBin -EXIF:TestNeg -EXIF:TestExpr
#------------------------------------------------------------------------------

%Image::ExifTool::UserDefined = (
    'Image::ExifTool::Exif::Main' => {
        0xd0_01 => {
            Name => 'TestHex',
            Writable => 'int16u',
            WriteGroup => 'IFD0',
            PrintConv => { 0x01 => 'hex one', 0X2 => 'hex two' },
        },
        53250 => {
            Name => 'TestDec',
            Writable => 'int16u',
            WriteGroup => 'IFD0',
            PrintConv => { 2 => 'dec two', '3' => 'string three', 2.0 => 'float two' },
        },
        0150003 => {
            Name => 'TestOct',
            Writable => 'int16u',
            WriteGroup => 'IFD0',
            PrintConv => { 010 => 'octal ten', 00 => 'octal zero' },
        },
        0b1101000000000100 => {
            Name => 'TestBin',
            Writable => 'int16u',
            WriteGroup => 'IFD0',
            PrintConv => { 0b1010 => 'binary ten', 1_0_0 => 'hundred' },
        },
        0xd005 => {
            Name => 'TestNeg',
            Writable => 'int16s',
            WriteGroup => 'IFD0',
            PrintConv => { -1 => 'minus one', - 2 => 'minus two', +3 => 'plus three' },
            Groups => { 2 => 'Camera' },
        },
        0xd000 + 6 => {
            Name => 'TestExpr',
            Writable => 'int16u',
            WriteGroup => 'IFD0',
            PrintConv => {
                1 << 4 => 'shifted',
                0x30 | 0x01 => 'or',
                0xff & 0x12 => 'and',
                2 * 3 + 1 => 'arith',
                1.5e1 => 'float key',
                .5 => 'half',
            },
        },
    },
);

1;  #end

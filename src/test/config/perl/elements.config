#------------------------------------------------------------------------------
# File:         elements.config
#
# Description:  Test config file: element assignments to the package hashes
#               and arrays, duplicate keys and later assignments
#
# test: -TestElem=7 -TestLater=1 -o OUT.jpg vendor/exiftool/t/images/Writer.jpg
# test: -a -G1 -s -TestElem -TestLater -TestFirst LAST.jpg
# test: -s -TestShort -TestNested vendor/exiftool/t/images/Canon.jpg
# test: -s -GPSPosition vendor/exiftool/t/images/GPS.jpg
#------------------------------------------------------------------------------

%Image::ExifTool::UserDefined = (
    'Image::ExifTool::Exif::Main' => {
        0xd101 => { Name => 'TestFirst', Writable => 'int16u', WriteGroup => 'IFD0' },
        0xd101 => { Name => 'TestLater', Writable => 'int16u', WriteGroup => 'IFD0',
                    PrintConv => { 1 => 'first', 1 => 'second' } },
    },
);

# (adds to the hash assigned above)
$Image::ExifTool::UserDefined{'Image::ExifTool::Exif::Main'}{0xd102} = {
    Name => 'TestElem',
    Writable => 'int16u',
};
$Image::ExifTool::UserDefined{'Image::ExifTool::Exif::Main'}->{0xd102}{WriteGroup} = 'IFD0';
$Image::ExifTool::UserDefined{'Image::ExifTool::Exif::Main'}{0xd102}->{PrintConv}{7} = 'seven';

# (an element of a hash that is not assigned whole, autovivified)
$Image::ExifTool::UserDefined::Shortcuts{TestShort} = [ 'Make' ];
$Image::ExifTool::UserDefined::Shortcuts{TestShort}[1] = 'Model';
$Image::ExifTool::UserDefined::Shortcuts{TestNested}[0] = 'ISO';
$Image::ExifTool::UserDefined::Options{CoordFormat} = '%d deg';
$Image::ExifTool::UserDefined::Options{CoordFormat} = '%.3f';

1;  #end

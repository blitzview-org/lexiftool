#------------------------------------------------------------------------------
# File:         xmp_namespace.config
#
# Description:  Test config file: a new XMP namespace with plain, list,
#               lang-alt and structure tags (data only)
#
# test: -XMP-testns:Plain=one -XMP-testns:Number=42 -XMP-testns:Items=a -XMP-testns:Items=b -XMP-testns:Title-de=Titel -XMP-testns:Title=title -o OUT.xmp vendor/exiftool/t/images/XMP.xmp
# test: -a -G1 -XMP-testns:all LAST.xmp
# test: '-XMP-testns:Thing={Size=3,Label=x}' -o OUT.jpg vendor/exiftool/t/images/Writer.jpg
# test: -G1 -s -struct -XMP-testns:all LAST.jpg
# test: -G1 -s -XMP-testns:all LAST.jpg
# test: -listx -XMP-testns:all
# test: -list -XMP-testns:all
#------------------------------------------------------------------------------

%Image::ExifTool::UserDefined = (
    'Image::ExifTool::XMP::Main' => {
        testns => {
            SubDirectory => {
                TagTable => 'Image::ExifTool::UserDefined::testns',
            },
        },
    },
);

%Image::ExifTool::UserDefined::testns = (
    GROUPS    => { 0 => 'XMP', 1 => 'XMP-testns', 2 => 'Other' },
    NAMESPACE => { 'testns' => 'http://example.com/ns/testns/1.0/' },
    WRITABLE  => 'string',
    Plain     => { },
    Number    => { Writable => 'integer' },
    Items     => { List => 'Bag' },
    Title     => { Writable => 'lang-alt' },
    Thing     => {
        Struct => {
            Size  => { Writable => 'integer' },
            Label => { },
        },
    },
);

1;  #end
